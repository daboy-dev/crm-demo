        {
          "action": "expectVisible",
          "testId": "field-type"
        },
        {
          "action": "expectVisible",
          "testId": "save-button"
        }
      ]
    },
    {
      "id": "c3",
      "revision": 1,
      "task": 2,
      "text": "el detalle del cliente muestra su tipo correspondiente",
      "steps": [
        {
          "action": "goto",
          "page": "cliente-detalle"
        },
        {
          "action": "expectVisible",
          "testId": "client-detail"
        },
        {
          "action": "expectVisible",
          "testId": "field-type"
        }
      ]
    },
    {
      "id": "c4",
      "revision": 1,
      "task": 3,
      "text": "la lista de clientes permite filtrar por tipo de cliente",
      "steps": [
        {
          "action": "goto",
          "page": "clientes"
        },
        {
          "action": "click",
          "testId": "new-client-button"
        },
        {
          "action": "fill",
          "testId": "field-name",
          "value": "Empresa {{stamp}}"
        },
        {
          "action": "fill",
          "testId": "field-email",
          "value": "empresa-{{stamp}}@example.com"
        },
        {
          "action": "select",
          "testId": "field-type",
          "value": "company"
        },
        {
          "action": "click",
          "testId": "save-button"
        },
        {
          "action": "expectVisible",
          "testId": "client-detail"
        },
        {
          "action": "goto",
          "page": "clientes"
        },
        {
          "action": "select",
          "testId": "client-type-filter",
          "value": "company"
        },
        {
          "action": "expectVisible",
          "testId": "clients-table"
        },
        {
          "action": "expectText",
          "testId": "client-row",
          "text": "Empresa",
          "all": true
        }
      ]
