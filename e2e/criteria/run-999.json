{
  "run": 999,
  "criteria": [
    {
      "id": "c1",
      "revision": 1,
      "task": 1,
      "text": "La lista de facturas muestra la tabla",
      "steps": [
        { "action": "goto", "page": "facturas" },
        { "action": "expectVisible", "testId": "invoices-table" },
        { "action": "expectCount", "testId": "invoice-row", "min": 1 }
      ]
    },
    {
      "id": "c2",
      "revision": 1,
      "task": 1,
      "text": "Prueba que falla: no existe invoice-status-filter",
      "steps": [
        { "action": "goto", "path": "/facturas" },
        { "action": "select", "testId": "invoice-status-filter", "value": "paid" }
      ]
    },
    {
      "id": "c3",
      "revision": 1,
      "task": 1,
      "text": "Crear un cliente con {{stamp}} y verlo en el detalle",
      "steps": [
        { "action": "goto", "page": "clientes" },
        { "action": "click", "testId": "new-client-button" },
        { "action": "fill", "testId": "field-name", "value": "Criterio {{stamp}}" },
        { "action": "fill", "testId": "field-email", "value": "criterio-{{stamp}}@example.com" },
        { "action": "click", "testId": "save-button" },
        { "action": "expectText", "testId": "page-title", "text": "Criterio {{stamp}}" }
      ]
    }
  ]
}
